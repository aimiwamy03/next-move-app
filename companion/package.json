{
  "name": "mindful-reentry-conversation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "content:index": "tsx --env-file-if-exists=.env.local scripts/content-index.ts",
    "demo:reset": "tsx --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "demo:preflight": "tsx --env-file-if-exists=.env.local scripts/demo-preflight.ts"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
